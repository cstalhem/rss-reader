# RSS Reader Environment Variables
# Copy to .env and customize

# Azure OpenAI credentials (required for scoring/categorization).
# Either endpoint string shown in the Azure portal works — the bare
# resource host or the full .../openai/v1 URL.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=

# Optional overrides of config/app.yaml settings
# DATABASE__PATH=/data/rss-reader.db
# LOGGING__LEVEL=DEBUG
# SCHEDULER__LOG_JOB_EXECUTION=true
